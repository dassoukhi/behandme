      "enums": null,
      "functions": [
        {
          "proname": "get_contract_with_validators",
          "args": "contract_id uuid",
          "security_definer": false,
          "definition": "CREATE OR REPLACE FUNCTION public.get_contract_with_validators(contract_id uuid)\n RETURNS json\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n  result json;\nBEGIN\n  SELECT json_build_object(\n    'id', c.id,\n    'name', c.name,\n    'description', c.description,\n    'owner_id', c.owner_id,\n    'secret_hash', c.secret_hash,\n    'blockchain_tx_id', c.blockchain_tx_id,\n    'blockchain_network', c.blockchain_network,\n    'accessor_id', c.accessor_id,\n    'validators', c.validators,\n    'status', c.status,\n    'created_at', c.created_at,\n    'updated_at', c.updated_at,\n    'meta', c.meta,\n    'owner', row_to_json(owner.*),\n    'accessor', row_to_json(accessor.*),\n    'validators_list', (\n      SELECT json_agg(u.*)\n      FROM users u\n      WHERE u.id = ANY(c.validators)\n      ORDER BY array_position(c.validators, u.id)\n    )\n  ) INTO result\n  FROM contracts c\n  LEFT JOIN users owner ON owner.id = c.owner_id\n  LEFT JOIN users accessor ON accessor.id = c.accessor_id\n  WHERE c.id = contract_id;\n  \n  RETURN result;\nEND;\n$function$\n"
        },
        {
          "proname": "get_trusted_users",
          "args": "owner_uuid text",
          "security_definer": false,
          "definition": "CREATE OR REPLACE FUNCTION public.get_trusted_users(owner_uuid text)\n RETURNS SETOF users\n LANGUAGE sql\nAS $function$\n  SELECT u.* \n  FROM trusted t\n  JOIN users u ON t.trusted_id = u.id\n  WHERE t.owner_id = owner_uuid;\n$function$\n"
        }
