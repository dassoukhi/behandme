  "info": {
    "title": "NestJS Supabase API",
    "description": "The NestJS Supabase API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "type": {
            "type": "string",
            "description": "Kind of notification, e.g. trust_added. Unknown kinds may appear: show them as generic.",
            "example": "trust_added"
          },
          "title": {
            "type": "string",
            "example": "Nouveau proche"
          },
          "body": {
            "type": "string",
            "example": "Sam Durand vous a ajouté à ses proches."
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Includes `url`, the app screen to open when tapped",
            "example": {
              "url": "/people/user_2abc123def456"
            }
          },
          "read_at": {
            "type": "string",
            "nullable": true,
            "description": "When it was read; null while unread",
            "example": null
          },
          "created_at": {
            "type": "string",
            "example": "2026-10-14T12:34:56.000Z"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "body",
          "data",
          "read_at",
          "created_at"
        ]
      },
      "UnreadCountDto": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "count"
        ]
      },
      "MarkedReadDto": {
        "type": "object",
        "properties": {
          "updated": {
            "type": "number",
            "description": "Notifications marked as read",
            "example": 3
          }
        },
        "required": [
          "updated"
        ]
      },
      "PushTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^Expo(nent)?PushToken\\[[^\\]]+\\]$",
            "description": "Expo push token of this device",
            "example": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
          }
        },
        "required": [
          "token"
        ]
      },
      "NotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "push_enabled": {
            "type": "boolean",
            "description": "Push for non-critical notifications. Critical ones (a claim on your contract) are always pushed.",
            "example": true
          }
        },
        "required": [
          "push_enabled"
        ]
      },
      "UpdateNotificationPreferencesDto": {
        "type": "object",
        "properties": {
          "push_enabled": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "UpdateNotificationDto": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean",
            "description": "Read (true) or unread (false)",
            "example": true
          }
        },
        "required": [
          "read"
        ]
      },
      "CreateContractDTO": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "networks",
              "devices",
              "storage"
            ],
            "type": "string",
            "description": "Contract category",
            "example": "networks"
          },
          "description": {
            "type": "string",
            "maxLength": 280,
            "description": "Short description visible to every participant: never put anything secret here",
            "example": "Accès à mes réseaux sociaux"
          },
          "accessor_id": {
            "type": "string",
            "description": "Clerk ID of the accessor (must be someone the caller trusts)",
            "example": "user_2qrstuvwxyz123456"
          },
          "validators": {
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 3,
            "description": "Clerk IDs of 1 to 3 distinct validators (people the caller trusts)",
            "example": [
              "user_2aaaaaaaaaaaaaaa",
              "user_2bbbbbbbbbbbbbbb"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "accessor_id",
          "validators"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Clerk user ID",
            "example": "user_2abc123def456"
          },
          "email": {
            "type": "string",
            "description": "User email. Only returned for yourself and for users who trust you.",
            "example": "john.doe@example.com"
          },
          "first_name": {
            "type": "string",
            "nullable": true,
            "description": "User first name",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "description": "User last name",
            "example": "Doe"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "User avatar URL",
            "example": "https://example.com/avatar.png"
          },
          "phone_number": {
            "type": "string",
            "nullable": true,
            "description": "User phone number. Only returned for yourself and for users who trust you.",
            "example": "+33612345678"
          },
          "created_at": {
