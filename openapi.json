  "info": {
    "title": "NestJS Supabase API",
    "description": "The NestJS Supabase API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Expo push token of the device",
            "example": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
          }
        },
        "required": [
          "token"
        ]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the notification",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "description": "Identifier of the recipient user",
            "example": "user_2abc123def456"
          },
          "title": {
            "type": "string",
            "description": "Title of the notification",
            "example": "Contract updated"
          },
          "message": {
            "type": "string",
            "description": "Message content of the notification",
            "example": "Your contract has been updated."
          },
          "type": {
            "nullable": true,
            "enum": [
              "contract_created",
              "contract_updated",
              "reminder",
              "system"
            ],
            "type": "string",
            "description": "Type of notification"
          },
          "is_read": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates whether the notification has been read",
            "default": false
          },
          "created_at": {
            "type": "string",
            "nullable": true,
            "description": "Timestamp when the notification was created",
            "example": "2023-10-10T12:34:56Z"
          },
          "scheduled_at": {
            "type": "string",
            "nullable": true,
            "description": "Scheduled time for the notification",
            "example": "2023-10-11T12:00:00Z"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Additional metadata",
            "example": {
              "key": "value"
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Payload delivered with the notification",
            "example": {
              "contractId": "4bce1a03-3fa5-4d39-8c7e-7f3b7e3468a5"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "title",
          "message",
          "type",
          "is_read",
          "created_at",
          "scheduled_at",
          "meta",
          "data"
        ]
      },
      "UpdateNotificationDto": {
        "type": "object",
        "properties": {
          "is_read": {
            "type": "boolean",
            "description": "Indicates whether the notification has been read",
            "example": true
          }
        },
        "required": [
          "is_read"
        ]
      },
      "CreateContractDTO": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "networks",
              "devices",
              "storage"
            ],
            "type": "string",
            "description": "Contract category",
            "example": "networks"
          },
          "description": {
            "type": "string",
            "maxLength": 280,
            "description": "Short description visible to every participant: never put anything secret here",
            "example": "Accès à mes réseaux sociaux"
          },
          "accessor_id": {
            "type": "string",
            "description": "Clerk ID of the accessor (must be someone the caller trusts)",
            "example": "user_2qrstuvwxyz123456"
          },
          "validators": {
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 3,
            "description": "Clerk IDs of 1 to 3 distinct validators (people the caller trusts)",
            "example": [
              "user_2aaaaaaaaaaaaaaa",
              "user_2bbbbbbbbbbbbbbb"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "accessor_id",
          "validators"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Clerk user ID",
            "example": "user_2abc123def456"
          },
          "email": {
            "type": "string",
            "description": "User email. Only returned for yourself and for users who trust you.",
            "example": "john.doe@example.com"
          },
          "first_name": {
            "type": "string",
            "nullable": true,
            "description": "User first name",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "description": "User last name",
            "example": "Doe"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "description": "User avatar URL",
            "example": "https://example.com/avatar.png"
          },
          "phone_number": {
            "type": "string",
            "nullable": true,
            "description": "User phone number. Only returned for yourself and for users who trust you.",
            "example": "+33612345678"
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the profile was created",
            "example": "2023-01-01T00:00:00.000Z"
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the profile was last updated",
            "example": "2023-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "created_at",
          "updated_at"
        ]
      },
      "ContractDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "4bce1a03-3fa5-4d39-8c7e-7f3b7e3468a5"
          },
          "name": {
            "enum": [
              "networks",
              "devices",
              "storage"
            ],
            "type": "string",
            "example": "networks"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Short description visible to every participant",
            "example": "Accès à mes réseaux sociaux"
          },
          "owner_id": {
            "type": "string",
            "example": "user_2abcdefghijklmnop"
          },
          "accessor_id": {
            "type": "string",
            "nullable": true,
            "example": "user_2qrstuvwxyz123456"
          },
          "validators": {
            "example": [
              "user_2aaaaaaaaaaaaaaa"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "nullable": true,
            "enum": [
              "draft",
              "active",
              "validated",
              "released",
              "revoked"
            ],
            "type": "string",
            "description": "Lifecycle status, changed only by dedicated actions"
          },
          "created_at": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-12T07:20:50.52Z"
          },
          "updated_at": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-15T09:30:50.52Z"
          },
          "owner": {
            "nullable": true,
            "description": "Owner profile (joined on list and detail endpoints)",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserProfileDto"
              }
            ]
          },
          "accessor": {
            "nullable": true,
            "description": "Accessor profile (joined on list and detail endpoints)",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserProfileDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner_id",
          "accessor_id",
          "validators",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "ContractValidatorsDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "4bce1a03-3fa5-4d39-8c7e-7f3b7e3468a5"
          },
          "name": {
            "enum": [
              "networks",
              "devices",
              "storage"
            ],
            "type": "string",
            "example": "networks"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Short description visible to every participant",
            "example": "Accès à mes réseaux sociaux"
          },
          "owner_id": {
            "type": "string",
            "example": "user_2abcdefghijklmnop"
          },
          "accessor_id": {
            "type": "string",
            "nullable": true,
            "example": "user_2qrstuvwxyz123456"
          },
          "validators": {
            "example": [
              "user_2aaaaaaaaaaaaaaa"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "nullable": true,
            "enum": [
              "draft",
              "active",
              "validated",
              "released",
              "revoked"
            ],
            "type": "string",
            "description": "Lifecycle status, changed only by dedicated actions"
          },
          "created_at": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-12T07:20:50.52Z"
          },
          "updated_at": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-15T09:30:50.52Z"
          },
          "owner": {
            "nullable": true,
            "description": "Owner profile (joined on list and detail endpoints)",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserProfileDto"
              }
            ]
          },
          "accessor": {
            "nullable": true,
            "description": "Accessor profile (joined on list and detail endpoints)",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/UserProfileDto"
              }
            ]
          },
          "validators_list": {
            "description": "Validator profiles, in the order of `validators`",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserProfileDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "owner_id",
          "accessor_id",
          "validators",
          "status",
          "created_at",
          "updated_at",
          "validators_list"
        ]
      },
      "UpdateContractDTO": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "networks",
              "devices",
              "storage"
            ],
            "type": "string",
            "description": "Contract category",
            "example": "networks"
          },
          "description": {
            "type": "string",
            "maxLength": 280,
            "description": "Short description visible to every participant: never put anything secret here",
            "example": "Accès à mes réseaux sociaux"
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email",
            "example": "john.doe@example.com"
          },
          "first_name": {
            "type": "string",
            "description": "User first name",
            "example": "John"
          },
          "last_name": {
            "type": "string",
            "description": "User last name",
            "example": "Doe"
          },
          "avatar_url": {
            "type": "string",
            "description": "User avatar URL",
            "example": "https://example.com/avatar.png"
          },
          "phone_number": {
            "type": "string",
            "description": "User phone number",
            "example": "+33612345678"
          }
        },
        "required": [
          "email"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
