# Copy to deploy/vm/env/notifier.env on the server.
# The Supabase pooler in transaction mode (port 6543), with this service's own role (docs/deploy.md).
DATABASE_URL=postgresql://svc_notifier.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Optional: Expo's access token, if "enhanced security for push notifications" is on.
# EXPO_ACCESS_TOKEN=
# E-mail (docs/deploy.md, "E-mail"): a Resend key with sending access, limited to behyndme.com. Without it,
# e-mail is off. The sender's domain must be verified at Resend.
# RESEND_API_KEY=
# EMAIL_FROM=BehyndMe <alertes@behyndme.com>
