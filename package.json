{
  "name": "nestjs-supabase-backend",
  "version": "0.1.0",
  "description": "NestJS backend application with Supabase integration",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "fabric:setup": "./scripts/setup-fabric-fixed.sh",
    "fabric:down": "cd \"fabric-network/fabric-samples/test-network\" && ./network.sh down",
    "fabric:up": "cd \"fabric-network/fabric-samples/test-network\" && ./network.sh up createChannel -ca",
    "deploy:asset-chaincode": "./scripts/deploy-chaincode-generic.sh basic fabric-network/fabric-samples/asset-transfer-basic/chaincode-javascript node 1.0 1",
    "deploy:user-chaincode": "./scripts/deploy-chaincode-generic.sh user-transfer-basic fabric-network/fabric-samples/asset-transfer-basic/chaincode-javascript-user node 1.0 1"
  },
  "dependencies": {
    "@hyperledger/fabric-gateway": "^1.7.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "@supabase/supabase-js": "^2.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fabric-ca-client": "^2.2.20",
    "fabric-client": "^1.4.20",
    "fabric-network": "^2.2.20",
    "fabric-shim": "^2.5.8",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sort-keys-recursive": "^2.1.10",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
