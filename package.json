{
  "name": "nestjs-supabase-backend",
  "version": "0.1.0",
  "description": "NestJS backend application with Supabase integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build --all",
    "openapi": "nest build gateway && node dist/apps/gateway/apps/gateway/src/openapi.js openapi.json",
    "verify": "bash scripts/verify.sh",
    "check:rls": "node scripts/check-rls.mjs",
    "check:deps": "depcruise apps libs --config .dependency-cruiser.cjs",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "start": "nest start gateway",
    "start:dev": "nest start gateway --watch",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/apps/gateway/src/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@clerk/backend": "^2.6.2",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "expo-server-sdk": "^4.0.0",
    "kysely": "^0.29.6",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.2"
  }
}
