{
  "name": "nestjs-supabase-backend",
  "version": "0.1.0",
  "description": "BehindMe backend: gateway, notifier and worker services (NestJS monorepo)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build --all",
    "openapi": "nest build gateway && node dist/apps/gateway/apps/gateway/src/openapi.js openapi.json",
    "verify": "bash scripts/verify.sh",
    "check:rls": "node scripts/check-rls.mjs",
    "check:schema": "CHECK_SCHEMA=1 vitest run libs/testing/src/schema-drift.spec.ts",
    "check:deps": "depcruise apps libs --config .dependency-cruiser.cjs",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "dev": "concurrently -k -n gateway,notifier,handover,worker -c blue,magenta,yellow,green \"npm:start:dev\" \"npm:start:dev:notifier\" \"npm:start:dev:handover\" \"npm:start:dev:worker\"",
    "start": "nest start gateway",
    "start:dev": "nest start gateway --watch",
    "start:dev:notifier": "nest start notifier --watch",
    "start:dev:handover": "nest start handover --watch",
    "start:dev:worker": "nest start worker --watch",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/apps/gateway/src/main.js",
    "start:prod:notifier": "node dist/apps/notifier/apps/notifier/src/main.js",
    "start:prod:handover": "node dist/apps/handover/apps/handover/src/main.js",
    "start:prod:worker": "node dist/apps/worker/apps/worker/src/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "canonicalize": "5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "expo-server-sdk": "^7.2.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "10.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.2"
  }
}
