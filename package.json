{
  "name": "nestjs-supabase-backend",
  "version": "0.1.0",
  "description": "NestJS backend application with Supabase integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "openapi": "nest build && node dist/openapi.js",
    "verify": "bash scripts/verify.sh",
    "check:rls": "node scripts/check-rls.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@clerk/backend": "^2.6.2",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@supabase/supabase-js": "^2.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "expo-server-sdk": "^4.0.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.1.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.2"
  }
}
