# Local development. Every service reads its own file first (.env.gateway, .env.notifier,
# .env.handover, .env.worker: what differs between services, such as DATABASE_URL), then this shared .env.
# On the host (Railway) the same variables are set per service; see docs/deploy.md.

# --- shared (.env) ------------------------------------------------------------------------------

NODE_ENV=development

# Signs the calls between services. At least 32 characters: openssl rand -base64 48
INTERNAL_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# --- gateway (.env or .env.gateway) -------------------------------------------------------------

PORT=3000

# Supabase: only read by npm run check:rls (the services use their own Postgres roles)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk (auth): verifies the mobile app's session tokens
CLERK_SECRET_KEY=sk_test_your-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Where the gateway reaches the other services
NOTIFIER_URL=http://localhost:3001
HANDOVER_URL=http://localhost:3003

# --- per service: .env.gateway, .env.notifier, .env.worker --------------------------------------
# Postgres through the Supabase pooler (transaction mode, port 6543), with the service's own role:
# svc_gateway, svc_notifier, svc_handover or svc_worker. The user name is "<role>.<project-ref>".
# DATABASE_URL=postgresql://svc_gateway.your-project-ref:password@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# .env.notifier only: PORT=3001, and optionally Expo's push access token
# EXPO_ACCESS_TOKEN=your-expo-access-token

# .env.handover only: PORT=3003
# .env.worker only: PORT=3002 (health check)

# Gateway, development only: seconds before others may use keys after a reset (default 72 h). Refused when
# NODE_ENV=production. Example: 60 to test a key reset without waiting.
# KEY_QUARANTINE_SECONDS_OVERRIDE=60
