{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@lib/kernel": ["./libs/kernel/src/index.ts"],
      "@lib/messaging": ["./libs/messaging/src/index.ts"],
      "@lib/persistence": ["./libs/persistence/src/index.ts"],
      "@lib/testing": ["./libs/testing/src/index.ts"]
    }
  },
  "include": ["apps/*/src/**/*", "libs/*/src/**/*"],
  "exclude": ["node_modules", "dist", "fabric-network"]
}
